{
  "name": "lightsquare",
  "version": "0.0.1",
  "description": "A chessboard that stays smooth on every phone. Pieces move with CSS transforms on the GPU, no animation loop, no dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lightsquare.css": "./dist/lightsquare.css",
    "./pieces/cburnett.css": "./dist/pieces/cburnett.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pieces": "node scripts/pieces.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:all": "vitest run && vitest run --config vitest.browser.config.ts",
    "bench": "node bench/server.mjs"
  },
  "keywords": [
    "chess",
    "chessboard",
    "board",
    "mobile",
    "performance"
  ],
  "author": "Kibitzo (https://kibitzo.com)",
  "homepage": "https://kibitzo.com/lightsquare",
  "license": "MIT",
  "devDependencies": {
    "chess.js": "^1.4.0",
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
