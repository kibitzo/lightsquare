{
  "name": "lightsquare",
  "version": "0.0.1",
  "description": "A chessboard that stays smooth on every phone. Pieces move with CSS transforms on the GPU, no animation loop, no dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shapes": {
      "types": "./dist/modules/shapes.d.ts",
      "import": "./dist/modules/shapes.js"
    },
    "./promotion": {
      "types": "./dist/modules/promotion.d.ts",
      "import": "./dist/modules/promotion.js"
    },
    "./overlay": {
      "types": "./dist/modules/overlay.d.ts",
      "import": "./dist/modules/overlay.js"
    },
    "./a11y": {
      "types": "./dist/modules/a11y.d.ts",
      "import": "./dist/modules/a11y.js"
    },
    "./premove": {
      "types": "./dist/modules/premove.d.ts",
      "import": "./dist/modules/premove.js"
    },
    "./theme": {
      "types": "./dist/modules/theme.d.ts",
      "import": "./dist/modules/theme.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./lightsquare.css": "./dist/lightsquare.css",
    "./pieces/cburnett.css": "./dist/pieces/cburnett.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pieces": "node scripts/pieces.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:all": "vitest run && vitest run --config vitest.browser.config.ts",
    "bench": "node bench/server.mjs",
    "icons": "node scripts/icons.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "keywords": [
    "chess",
    "chessboard",
    "board",
    "mobile",
    "performance"
  ],
  "author": "Kibitzo (https://kibitzo.com)",
  "homepage": "https://kibitzo.github.io/lightsquare/",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chess.js": "^1.4.0",
    "esbuild": "^0.28.1",
    "playwright": "1.61.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibitzo/lightsquare.git"
  },
  "bugs": {
    "url": "https://github.com/kibitzo/lightsquare/issues"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
