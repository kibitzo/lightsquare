{
  "name": "lightsquare-compare",
  "private": true,
  "description": "Measures Lightsquare next to other chessboards. A project of its own: its dependencies are not Lightsquare's, and nothing here is part of the library or of its npm package.",
  "type": "module",
  "scripts": {
    "measure": "npm --prefix .. run build --silent && tsc -p . && node run.mjs",
    "sizes": "npm --prefix .. run build --silent && node run.mjs --sizes",
    "report": "node run.mjs --report"
  },
  "dependencies": {
    "@chrisoakman/chessboardjs": "^1.0.0",
    "@lichess-org/chessground": "latest",
    "cm-chessboard": "latest",
    "jquery": "^4.0.0",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/jquery": "^4.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chess.js": "^1.4.0",
    "esbuild": "^0.28.1",
    "playwright": "1.61.1",
    "typescript": "^5.6.0"
  }
}
